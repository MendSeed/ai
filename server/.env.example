# =================================================================
# MendSeed AI Gateway — Environment Configuration Template
# NOTE: Never commit production API keys or tokens to source control.
# =================================================================

# Required: Gateway Secret Key for authenticating backend service calls (X-MendSeed-Key header)
# Replace with a cryptographically secure random string (e.g. openssl rand -hex 32)
MENDSEED_AI_SECRET_KEY=your_secret_key_here

# Optional: CORS allowed origins (comma-separated). Leave empty to disallow credentials and restrict access.
# Browser JavaScript must never call this private gateway directly with the secret key.
MENDSEED_CORS_ORIGINS=http://localhost:3000,https://mendseed.org

# Optional: Rate limit in requests per minute per client IP (default: 120, set 0 to disable)
MENDSEED_RATE_LIMIT_PER_MINUTE=120

# Inference Provider Configuration: 'huggingface', 'custom_endpoint', 'mock', or 'none'
MODEL_PROVIDER=huggingface
BASE_MODEL=Qwen/Qwen2.5-3B-Instruct
ADAPTER_ID=
ADAPTER_REVISION=
REQUIRE_ADAPTER=false

# Remote Inference Endpoint URL (Hugging Face Dedicated Endpoint, Serverless Inference API, or vLLM)
HF_ENDPOINT_URL=https://api-inference.huggingface.co/models/<org>/<model>

# Hugging Face Access Token with read access for private endpoints/adapters
HF_TOKEN=hf_your_token_here

# Model Generation Parameters
MODEL_TEMPERATURE=0.1
MODEL_MAX_NEW_TOKENS=512
MODEL_TIMEOUT_SECONDS=25.0
